# Copy to .env and set for your machine. The real .env is gitignored.

# Path to the ArmorPaint executable. Must be run from the layout MSBuild
# produces + make.bat's asset export merged together (paint\build\out\
# ArmorPaint.exe next to its own data\ dir) -- the plain
# paint\build\x64\Release\ArmorPaint.exe access-violates on launch with no
# log output if data\ isn't next to it. See README "Build gotcha".
AP_BINARY=C:\path\to\ArmorPaint\paint\build\out\ArmorPaint.exe

# Where exported textures/meshes/materials land (defaults to ./output if unset).
AP_OUTPUT_DIR=C:\path\to\Tool-ArmorPaintMCP\output

# Optional: os.pathsep-separated list of directories the server will read/write
# within. Unset means unrestricted (paths still can't contain ".." or escape
# via an absolute path outside every listed root once this IS set).
AP_ALLOWED_ROOTS=
